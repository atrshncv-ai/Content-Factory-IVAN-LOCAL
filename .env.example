# Контент-завод — конфигурация Node 2. Скопировать в .env и заполнить.

# --- Пул API-ключей (провайдер без ключа пропускается в fallback-цепочке) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Модели провайдеров ---
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Локальный fallback: LM Studio (всегда последний в цепочке) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# --- Операционная память (SQLite) ---
DB_PATH=data/factory.db

# --- Парсер трендов: Scrape Creators (primary) → crawl4ai → Jina (fallback) ---
SCRAPE_CREATORS_API_KEY=
SCRAPE_CREATORS_BASE_URL=https://api.scrapecreators.com/v1

# --- Связь с Node 1 (ComfyUI): гибрид A+B (pull + poll) ---
SHARED_FOLDER=shared
COMFYUI_SERVER_URL=http://localhost:8188
TAILSCALE_PROXY_TARGET_HOST=100.64.0.1
TAILSCALE_PROXY_TARGET_PORT=8188
TAILSCALE_PROXY_LISTEN_HOST=127.0.0.1
TAILSCALE_PROXY_LISTEN_PORT=18188
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MVP_DIR=data/telegram
JOBS_DIR=data/jobs

# --- Контролёр Качества: Safety Valve микро-Ralph Loop ---
EVALUATOR_MAX_RETRIES=3

# --- SMM-Паблишер: CLI-утилита автопостинга ---
AUTOPOST_COMMAND=autopost

# --- Оркестратор: Node 1 (ComfyUI) и тематика контента ---
COMFYUI_COMMAND=cli-anything-comfyui
COMFYUI_WORKFLOW_TEMPLATE=assets/comfyui_workflow_template.json
COMFYUI_WORKFLOW_DIR=/tmp
COMFYUI_WORKFLOW_SHA256=
CONTENT_NICHE=ai

# --- Ticket 08: Mac Node 2, Node 1 и журнал ручной приёмки ---
HERMES_PROJECT_DIR=
HERMES_PYTHON=
HERMES_STATE_PATH=
HERMES_KNOWLEDGE_PATH=
TELEGRAM_ADMIN_ID_1=
TELEGRAM_ADMIN_ID_2=
OPENCODE_ZEN_API_KEY_1=
OPENCODE_ZEN_API_KEY_2=
ACCEPTANCE_LOG_PATH=data/acceptance.json
JOB_SERVER_HOST=
JOB_SERVER_PORT=
NODE2_URL=
COMFYUI_URL=
NODE1_COMFYUI_DIR=
NODE1_PYTHON_EXE=
NODE1_WATCHDOG_PY=
NODE1_LAUNCHER=
