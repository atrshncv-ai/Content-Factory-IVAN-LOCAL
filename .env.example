# Контент-завод — конфигурация Node 2. Скопировать в .env и заполнить.

# --- Пул API-ключей (провайдер без ключа пропускается в fallback-цепочке) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Модели провайдеров ---
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Локальный fallback: LM Studio (всегда последний в цепочке) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# --- Операционная память (SQLite) ---
DB_PATH=data/factory.db

# --- Парсер трендов: Scrape Creators (primary) + MarkUDown MCP (fallback) ---
SCRAPE_CREATORS_API_KEY=
SCRAPE_CREATORS_BASE_URL=https://api.scrapecreators.com/v1
MARKUDOWN_COMMAND=markudown

# --- Связь с Node 1 (ComfyUI): Webhook-приёмник + Shared Folder ---
SHARED_FOLDER=shared
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8099
