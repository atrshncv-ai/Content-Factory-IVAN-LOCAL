<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.hermes.content-factory</string>
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string><string>__PROJECT_DIR__/ops/macos/run_tick.sh</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>HERMES_PROJECT_DIR</key><string>__PROJECT_DIR__</string>
    <key>HERMES_PYTHON</key><string>__PYTHON__</string>
  </dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__LOG_DIR__/hermes.out.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/hermes.err.log</string>
</dict></plist>
